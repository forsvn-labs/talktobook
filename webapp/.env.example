# Copy to .env and fill in.

# Absolute public origin, used for canonical URLs.
PUBLIC_URL=http://localhost:8000

# Force HTTP requests to HTTPS. The app defaults this on when PUBLIC_URL uses https.
FORCE_HTTPS=

CONTACT_EMAIL=hello@talktobook.example
DMCA_EMAIL=dmca@talktobook.example

# Optional job storage override.
T2B_JOBS_DIR=

# Input guardrails.
MAX_TRANSCRIPT_CHARS=800000
MAX_UPLOAD_BYTES=8388608
