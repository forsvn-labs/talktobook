{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["src/components/ui", "dist"],
  "jsPlugins": ["@shadcn/lint"],
  "plugins": ["react", "typescript", "oxc"],
  "settings": {
    "shadcn": {
      "note": "Kobo desk DESIGN.md: dark room oklch(0.16 0.01 260), amber lamp oklch(0.78 0.09 75) as the only accent. Geist. Not a marketing page. Confirm still gates vault and Drive writes."
    }
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "shadcn/no-raw-colors": [
      "error",
      {
        "message": "Desk chrome uses tokens in src/index.css. Device frame greys in index.css are the exception for the reader bezel."
      }
    ],
    "shadcn/no-restyle": "off"
  },
  "overrides": [
    {
      "files": ["src/components/ui/*.{ts,tsx}"],
      "rules": {
        "react/only-export-components": "off",
        "react/purity": "off",
        "shadcn/no-restyle": "off",
        "shadcn/no-raw-colors": "off"
      }
    },
    {
      "files": ["src/components/device-stage.tsx"],
      "rules": {
        "shadcn/no-raw-colors": "off",
        "shadcn/no-restyle": "off"
      }
    }
  ]
}
